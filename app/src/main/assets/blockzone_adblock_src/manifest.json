{
  "manifest_version": 2,
  "name": "BlockZone Ad Blocker",
  "version": "3.0.0",
  "description": "Built-in filtering for the BlockZone protected browser.",
  "browser_specific_settings": {"gecko": {"id": "blockzone-adblock@local"}},
  "background": {"scripts": ["background.js"]},
  "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://youtube.com/*"], "js": ["youtube.js"], "run_at": "document_start"}],
  "permissions": ["<all_urls>", "webRequest", "webRequestBlocking", "storage", "nativeMessaging", "geckoViewAddons"]
}
