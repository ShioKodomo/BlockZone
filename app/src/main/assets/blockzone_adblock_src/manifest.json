{
  "manifest_version": 2,
  "name": "BlockZone Background Playback Helper",
  "version": "3.2.0",
  "description": "Keeps protected YouTube playback active when BlockZone is backgrounded.",
  "browser_specific_settings": {"gecko": {"id": "blockzone-adblock@local"}},
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": ["youtube.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": ["<all_urls>"]
}
