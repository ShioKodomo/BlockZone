.actionIcon svg{width:24px;height:24px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.action h3{margin:0 0 4px;font-size:13px}.action p{margin:0;color:#a98b9e;font-size:9px;line-height:1.35}.actionBadge{position:absolute;top:10px;right:10px;border:1px solid #ff57c46e;background:#ff3db315;color:#ff99dc;border-radius:99px;padding:3px 6px;font-size:7px;font-weight:800;letter-spacing:.08em}
.toolTabs{display:flex;gap:7px;overflow:auto;padding:2px 0 7px;scrollbar-width:none}.toolTab{border:1px solid #3e1a36;background:#0f0913;color:#a98b9e;border-radius:999px;padding:9px 12px;font-size:10px;white-space:nowrap}.toolTab.on{color:#250316;background:linear-gradient(90deg,#ff3db8,#ff79d1);border-color:#ffb9e5;box-shadow:0 0 18px #ff3db342;font-weight:850}.settingCard{padding:0 14px;margin-top:8px}.setting{display:grid;grid-template-columns:38px 1fr auto;gap:10px;align-items:center;padding:13px 0;border-bottom:1px solid #35142e}.setting:last-child{border-bottom:0}.settingIcon{width:36px;height:36px;border-radius:12px;display:grid;place-items:center;background:#ff3db317;border:1px solid #6b2658;color:#ff79ce;box-shadow:0 0 14px #ff3db31b}.settingIcon svg{width:19px;height:19px;stroke:currentColor;fill:none;stroke-width:1.8}.settingTitle{font-size:11px;font-weight:800}.settingDesc{font-size:8px;color:#9f8496;margin-top:3px}.miniBtn{border:1px solid #8d2e6e;background:#ff3db318;color:#ff9cdd;border-radius:11px;padding:8px 9px;font-size:8px;font-weight:800}.switch{width:45px;height:25px;padding:3px;border-radius:99px;background:#2a1b2b;border:1px solid #4f384c}.switch i{display:block;width:17px;height:17px;border-radius:50%;background:#d5c4d0;transition:.2s}.switch.on{background:#ff3db8;border-color:#ff9fdd;box-shadow:0 0 13px #ff3db348}.switch.on i{transform:translateX(18px);background:#fff}.assistantPanel{margin-top:14px;padding:12px}.assistantHero{display:grid;grid-template-columns:92px 1fr;gap:10px;align-items:center}.assistantHero img{width:92px;height:92px;border-radius:18px;object-fit:cover;object-position:50% 18%;border:1px solid #ff61c6;box-shadow:0 0 25px #ff3db32d}.assistantTitle{font-size:11px;color:#ff86d5;font-weight:900}.assistantBubble{margin-top:5px;border:1px solid #7d2a62;border-radius:14px;background:linear-gradient(135deg,#260e22,#130a15);padding:9px;color:#f6dceb;font-size:10px;line-height:1.4}.ask{display:flex;gap:7px;margin-top:10px}.ask input{min-width:0;flex:1;border:1px solid #64214f;background:#07050a;color:#fff;border-radius:13px;padding:10px 11px;font-size:10px}.ask button{border:1px solid #ff98dc;background:#ff3db8;color:#210315;border-radius:13px;width:42px;font-weight:950}.appCard{padding:0 14px}.appitem{display:grid;grid-template-columns:1fr auto;gap:8px;align-items:center;padding:12px 0;border-bottom:1px solid #34142d}.appName{font-size:11px;font-weight:800}.appMeta{font-size:8px;color:#9d8495}.nav{position:fixed;z-index:50;left:0;right:0;bottom:0;display:grid;grid-template-columns:repeat(4,1fr);padding:7px 4px calc(8px + env(safe-area-inset-bottom));background:rgba(7,4,10,.94);backdrop-filter:blur(18px);border-top:1px solid #4a193e;box-shadow:0 -15px 30px #0008}.nav.hide{display:none}.nav button{border:0;background:transparent;color:#806a7a;padding:5px 1px;font-size:8px}.navIcon{width:25px;height:25px;margin:0 auto 2px;display:grid;place-items:center}.navIcon svg{width:19px;height:19px;stroke:currentColor;fill:none;stroke-width:1.9}.nav button.on{color:#ff63c8;text-shadow:0 0 12px #ff3db3}.modal{position:fixed;z-index:80;inset:0;background:#000b;display:none;align-items:flex-end}.modal.show{display:flex}.sheet{width:100%;padding:18px 17px calc(22px + env(safe-area-inset-bottom));background:linear-gradient(180deg,#1b0d20,#09050d);border:1px solid #7f2a64;border-bottom:0;border-radius:25px 25px 0 0}.sheetKicker{font-size:9px;color:#ff7fd2;font-weight:800}.sheet h2{margin:6px 0 8px}.sheet p{color:#c4a6b9;font-size:11px;line-height:1.45}.sheet button{width:100%;margin-top:13px;border:1px solid #ff9ade;background:#ff3db8;color:#250316;border-radius:14px;padding:12px;font-weight:900}
</style></head><body>
<section id="splash" class="screen active"><div class="splashWrap"><div class="splashBg"></div><div class="splashGlow"></div><div class="splashLogo"><div class="logoText">Goth<span>Time</span></div><div class="splashTag">otimize seu Poco F1</div></div><div class="splashCopy"><p>MENOS LAG · MAIS TEMPO · MAIS CONTROLE</p><button class="cta" onclick="go('home')">Começar ›</button><div class="splashMeta"><span>OTIMIZAÇÃO</span><span>DESEMPENHO</span><span>CONTROLE</span></div></div></div></section>
<section id="home" class="screen"><div class="top"><div><div class="brandSmall">Goth<span>Time</span></div><div id="model" class="deviceName">POCO F1</div></div><img class="avatar" src="mascot.webp"></div><div class="card neon assistMini"><img src="mascot.webp"><div><div class="assistLabel">GothTime · Assistente</div><div id="assistantText" class="assistText">Seu aparelho pode ficar mais leve hoje. ♡</div></div></div><div class="card neon statusCard"><div class="statusTop"><div><div class="batteryLabel">BATERIA</div><div><span id="battery" class="batteryNum">--</span><span class="pink strong">%</span></div><div id="charge" class="batterySub">Lendo estado...</div><div class="batteryBar"><div id="batteryFill" class="batteryFill"></div></div></div><div class="ringWrap"><div><div id="ramRing" class="ring green"><span id="ramPct">--%</span></div><div class="tiny muted">RAM</div></div><div><div id="storageRing" class="ring"><span id="storagePct">--%</span></div><div class="tiny muted">ESPAÇO</div></div></div></div><div class="metrics"><div class="metric"><div class="metricIco">♨</div><div id="temp" class="metricVal">--°C</div><div class="metricLbl">Temperatura</div></div><div class="metric"><div class="metricIco">◌</div><div id="ramGb" class="metricVal">-- GB</div><div class="metricLbl">RAM em uso</div></div><div class="metric"><div class="metricIco">▣</div><div id="storageGb" class="metricVal">-- GB</div><div class="metricLbl">Armazenamento</div></div></div></div><div class="sectionTitle">Otimização rápida <span class="sectionHint">TOQUE PARA EXECUTAR</span></div><div class="actionGrid">