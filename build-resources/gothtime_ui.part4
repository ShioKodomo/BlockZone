<div id="nav" class="nav hide"><button id="nHome" onclick="go('home')"><div class="navIcon"><svg viewBox="0 0 24 24"><path d="M3 11l9-8 9 8v10h-6v-6H9v6H3z"/></svg></div>Início</button><button id="nTools" onclick="go('tools')"><div class="navIcon"><svg viewBox="0 0 24 24"><path d="M14 6l4 4-8 8-4 1 1-4zM15 5l2-2 4 4-2 2"/></svg></div>Ferramentas</button><button onclick="act('scan')"><div class="navIcon"><svg viewBox="0 0 24 24"><path d="M3 12h4l2-5 4 10 2-5h6"/></svg></div>Monitor</button><button onclick="go('tools')"><div class="navIcon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19 12a7 7 0 0 0-.1-1l2-1-2-4-2 1a7 7 0 0 0-2-1l-.3-2H10l-.3 2a7 7 0 0 0-2 1l-2-1-2 4 2 1a7 7 0 0 0 0 2l-2 1 2 4 2-1a7 7 0 0 0 2 1l.3 2h4l.3-2a7 7 0 0 0 2-1l2 1 2-4-2-1a7 7 0 0 0 .1-1z"/></svg></div>Config</button></div>
<div id="modal" class="modal" onclick="if(event.target===this)closeModal()"><div class="sheet"><div id="modalDetail" class="sheetKicker"></div><h2 id="modalTitle">GothTime</h2><p id="modalMessage"></p><button onclick="closeModal()">Entendi</button></div></div>
<script>
let state={};function nativeOk(){return typeof GothTime!=='undefined'}
function go(id){document.querySelectorAll('.screen').forEach(x=>x.classList.remove('active'));let s=document.getElementById(id);if(s)s.classList.add('active');document.getElementById('nav').classList.toggle('hide',id==='splash');document.querySelectorAll('.nav button').forEach(x=>x.classList.remove('on'));if(id==='home')document.getElementById('nHome').classList.add('on');if(id==='tools')document.getElementById('nTools').classList.add('on');if(id==='apps')showAppsOnly();refresh()}
function pct(a,b){return b?Math.max(0,Math.min(100,Math.round(a*100/b))):0}function gb(n){return n?(n/1073741824).toFixed(1):'--'}
function refresh(){if(!nativeOk())return;try{state=JSON.parse(GothTime.getState());let rp=pct(state.ramUsed,state.ramTotal),sp=pct(state.storageUsed,state.storageTotal);document.getElementById('model').textContent=(state.model||'POCO F1').toUpperCase()+' · ANDROID '+state.android;document.getElementById('battery').textContent=state.battery;document.getElementById('batteryFill').style.width=Math.max(2,state.battery)+'%';document.getElementById('charge').textContent=state.charging?'Carregando · monitor ativo':'Bateria · monitor ativo';document.getElementById('temp').textContent=state.temp+'°C';document.getElementById('ramPct').textContent=rp+'%';document.getElementById('storagePct').textContent=sp+'%';document.getElementById('ramRing').style.setProperty('--v',rp);document.getElementById('storageRing').style.setProperty('--v',sp);document.getElementById('ramGb').textContent=gb(state.ramUsed)+' GB';document.getElementById('storageGb').textContent=gb(state.storageUsed)+' GB';document.getElementById('advText').textContent=(state.root?'Root detectado':state.advanced?'ADB Advanced ativo':'Modo normal · toque em Testar');let msg=parseFloat(state.temp)>=42?'Seu Poco está quente. Eu evitaria Turbo agora.':sp>=88?'Seu armazenamento está apertado. Limpeza primeiro.':rp>=82?'RAM pressionada. Hibernação pode ajudar.':'Seu aparelho pode ficar mais leve hoje. ♡';document.getElementById('assistantText').textContent=msg;document.getElementById('autoSwitch').classList.toggle('on',!!GothTime.getAutoOptimize())}catch(e){}}
function act(a){try{showResult(JSON.parse(GothTime.runAction(a)));setTimeout(refresh,350)}catch(e){showResult({title:'GothTime',message:String(e),detail:'ERRO'})}}
function showResult(r){document.getElementById('modalTitle').textContent=r.title||'GothTime';document.getElementById('modalMessage').textContent=r.message||'';document.getElementById('modalDetail').textContent=r.detail||'';document.getElementById('modal').classList.add('show')}
function closeModal(){document.getElementById('modal').classList.remove('show')}
function toggleAction(el,on,off){let next=!el.classList.contains('on');el.classList.toggle('on',next);act(next?on:off)}
function toggleAuto(){let el=document.getElementById('autoSwitch'),next=!el.classList.contains('on');showResult(JSON.parse(GothTime.setAutoOptimize(next)));el.classList.toggle('on',next)}
function usage(){GothTime.requestUsageAccess()}function showApps(){go('apps')}
function showAppsOnly(){let list=[];try{state=JSON.parse(GothTime.getState());list=JSON.parse(GothTime.topApps())}catch(e){}let box=document.getElementById('appList'),note=document.getElementById('usageNotice');box.innerHTML='';if(!state.usage){note.innerHTML='O Android ainda não liberou o histórico de uso. <span class="pink strong" onclick="usage()">TOQUE AQUI PARA PERMITIR</span>';return}note.textContent=list.length?'Apps com maior tempo em primeiro plano:':'Nenhum app relevante encontrado.';list.forEach(a=>{let d=document.createElement('div');d.className='appitem';d.innerHTML='<div><div class="appName">'+esc(a.name)+'</div><div class="appMeta">'+a.min+' min · '+esc(a.pkg)+'</div></div><button class="miniBtn">HIBERNAR</button>';d.querySelector('button').onclick=()=>showResult(JSON.parse(GothTime.hibernatePackage(a.pkg)));box.appendChild(d)})}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function ask(){let i=document.getElementById('askText'),q=i.value.trim();if(!q)return;document.getElementById('chatReply').textContent=GothTime.ask(q);i.value=''}
refresh();setInterval(refresh,5000);
</script></body></html>